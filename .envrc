# direnv config for organize_music. Run `direnv allow` once to load it.
# These are the deploy/run values that used to be hardcoded in
# scripts/deploy_to_pi.sh. Override any of them per-machine in .envrc.local
# (gitignored), which is sourced at the end if present.

# --- Pi target (used by scripts/deploy_to_pi.sh) ---
export PI_HOST="ets04uga@192.168.1.222"   # 256GB-P5
export PI_DIR="organize_music"             # install dir, relative to the Pi user's home

# --- Music library (on the Pi) ---
export MUSIC_LIB="/media/ets04uga/Extreme/PlaceHereToKeepFromWork/Music"

# Per-machine overrides (e.g. a different IP or mDNS hostname). Not committed.
source_env_if_exists .envrc.local
