# direnv config for organize_music. Run `direnv allow` once to load it.
# Deploy/run values live in .envrc.local (gitignored), sourced at the end.

# --- Pi target and music library: set these in .envrc.local (gitignored) ---
#   export PI_HOST="user@pi-host-or-ip"   # used by scripts/deploy_to_pi.sh
#   export PI_DIR="organize_music"        # install dir, relative to the Pi user's home
#   export MUSIC_LIB="/path/to/Music"     # library path on the Pi

# --- hermes-review (PR reviewer agent, see docs/AGENTS_WORKFLOW.md) ---
# Local Ollama model that reviews Hermes PRs. A different model from Hermes's own
# (qwen3.8:27b-mlx) so the reviewer does not share the author's blind spots.
export REVIEWER_MODEL="qwen3-coder:latest"

# Per-machine overrides (e.g. a different IP or mDNS hostname). Not committed.
source_env_if_exists .envrc.local
