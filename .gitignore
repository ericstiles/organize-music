# Python virtual environment
.venv/
venv/
ENV/
env/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Linting cache
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# OS metadata
.DS_Store
Thumbs.db

# direnv per-machine overrides (.envrc itself is committed)
.envrc.local

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Generated reports (run output, not source)
reports/

# Packaging build output
*.egg-info/
build/
dist/

# Local-only Claude Code hook scripts
.claude/hooks/

# hermes-launch run logs
logs/
